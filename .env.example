# Which AI provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Optional: same provider, used for an episode only after all "busy" (503) retries fail
LLM_FALLBACK_MODEL=

# Only the key for the provider you use is needed
GEMINI_API_KEY=your-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional, openai only: any OpenAI-compatible API (Groq, OpenRouter, ...)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
